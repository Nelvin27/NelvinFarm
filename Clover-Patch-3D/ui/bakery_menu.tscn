[gd_scene format=3]

[ext_resource type="PackedScene" path="res://action_menu.tscn" id="1"]

[ext_resource type="Script" path="res://ui/bakery_menu.gd" id="2"]

[node name="BakeryMenu" instance=ExtResource("1")]
script = ExtResource("2")

[node name="Title" parent="Rows"]
text = "Valley Bakery"

[node name="Stock" type="Label" parent="Rows"]
layout_mode = 2
unique_name_in_owner = true
theme_override_font_sizes/font_size = 22

[node name="Buy" type="Button" parent="Rows"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
text = "Buy bread · 2 coins"

[node name="Close" type="Button" parent="Rows"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Close"

[connection signal="pressed" from="Rows/Buy" to="." method="emit_signal" binds= ["buy_requested"]]

[connection signal="pressed" from="Rows/Close" to="." method="emit_signal" binds= ["close_requested"]]
